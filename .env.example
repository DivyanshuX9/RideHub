# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values
#   cp .env.example .env.local
# ─────────────────────────────────────────────

# Backend now runs as Next.js serverless API routes.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
JWT_SECRET=your-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Add your deployed app URL to Google OAuth redirect URIs:
#   https://your-app.vercel.app/api/auth/google/callback

# Routing Providers Failover Chain for Client-Side Leaflet Maps
# Preferred provider order (defaults to tomtom,here,osrm)
NEXT_PUBLIC_ROUTING_PROVIDER_ORDER=tomtom,here,osrm
NEXT_PUBLIC_TOMTOM_API_KEY=
NEXT_PUBLIC_HERE_API_KEY=
